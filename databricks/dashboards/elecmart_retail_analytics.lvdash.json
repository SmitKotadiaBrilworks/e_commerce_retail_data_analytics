        "SELECT * FROM elecmart.gold.bi_clickstream_funnel_by_month"
      ]
    },
    {
      "name": "ds_device",
      "displayName": "sessions_by_device",
      "queryLines": [
        "SELECT * FROM elecmart.gold.bi_sessions_by_device"
      ]
    },
    {
      "name": "ds_campaign",
      "displayName": "campaign_performance",
      "queryLines": [
        "SELECT * FROM elecmart.gold.bi_campaign_performance ORDER BY attributed_revenue DESC LIMIT 15"
      ]
    },
    {
      "name": "ds_inv_cat",
      "displayName": "inventory_by_category",
      "queryLines": [
        "SELECT * FROM elecmart.gold.bi_inventory_by_category"
      ]
    },
    {
      "name": "ds_store",
      "displayName": "store_performance",
      "queryLines": [
        "SELECT * FROM elecmart.gold.bi_sales_by_store"
      ]
    }
