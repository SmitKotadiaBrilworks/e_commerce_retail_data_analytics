{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "kpi_summary",
      "queryLines": [
        "SELECT * FROM elecmart.gold.bi_kpi_summary"
      ]
    },
    {
      "name": "ds_rev_month",
      "displayName": "revenue_by_month",
      "queryLines": [
        "SELECT * FROM elecmart.gold.bi_revenue_by_month"
      ]
    },
    {
      "name": "ds_cat",
      "displayName": "sales_by_category",
      "queryLines": [
        "SELECT * FROM elecmart.gold.bi_sales_by_category"
      ]
    },
    {
      "name": "ds_channel",
      "displayName": "sales_by_channel",
      "queryLines": [
        "SELECT * FROM elecmart.gold.bi_sales_by_channel"
      ]
    },
    {
      "name": "ds_top_prod",
      "displayName": "top_products",
      "queryLines": [
        "SELECT * FROM elecmart.gold.bi_top_products LIMIT 15"
      ]
    },
    {
      "name": "ds_loyalty",
      "displayName": "customer_loyalty_mix",
      "queryLines": [
        "SELECT * FROM elecmart.gold.bi_customer_loyalty_mix"
      ]
    },
    {
      "name": "ds_funnel",
      "displayName": "clickstream_funnel_by_month",
