        {
          "widget": {
            "name": "hdr",
            "multilineTextboxSpec": {
              "lines": [
                "# Elecmart — Retail Analytics\n",
                "Net revenue, profitability, funnel, campaigns and inventory across 3 years. Source: `elecmart.gold.bi_*` views."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "c_rev",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_kpi",
                  "fields": [
                    {
                      "name": "sum(net_revenue)",
                      "expression": "SUM(`net_revenue`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(net_revenue)",
                  "displayName": "Sum of net_revenue",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "CAD",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 0
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Net Revenue"
              }
